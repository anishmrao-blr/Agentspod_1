# Google Analytics 4
# Already hardcoded in pages/_app.tsx — no env var needed
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Microsoft Clarity
# Get your Project ID from https://clarity.microsoft.com → Settings → Overview
NEXT_PUBLIC_CLARITY_ID=

# LinkedIn Insight Tag
# Get your Partner ID from https://www.linkedin.com/campaignmanager → Account Assets → Insight Tag
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Google Search Console
# Only needed if using meta tag verification. Prefer GA4 verification instead (no code change needed).
# Get from https://search.google.com/search-console → Add property → HTML tag method
NEXT_PUBLIC_GSC_VERIFICATION=
