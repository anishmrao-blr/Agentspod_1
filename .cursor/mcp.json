{
  "mcpServers": {
    "codegraphcontext": {
      "command": "python",
      "args": ["-m", "codegraphcontext", "mcp", "start"],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "vercel": {
      "url": "https://mcp.vercel.com"
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp"
    },
    "webflow": {
      "url": "https://mcp.webflow.com/sse"
    }
  }
}
